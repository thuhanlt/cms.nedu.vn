{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nedu-cms",
  "compatibility_date": "2025-01-01",
  "main": "./dist/_worker.js",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  },
  "env": {
    "dev": {
      "name": "nedu-cms-dev",
      "vars": {
        "ENVIRONMENT": "dev"
      }
    },
    "production": {
      "name": "nedu-cms-prod",
      "vars": {
        "ENVIRONMENT": "production"
      },
      "routes": [
        {
          "pattern": "cms.nedu.vn",
          "custom_domain": true
        }
      ]
    }
  }
}
