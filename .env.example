# Backend API base (Express/NestJS at api.nedu.vn). Mock mode không cần BE chạy.
VITE_API_URL=http://localhost:8080

# IAM Central Auth (cấp role editor/admin qua JWT)
VITE_AUTH_CENTRAL_URL=https://iam.nedu.vn

# true = data giả qua MSW (vibe code + Vercel preview)
# false = gọi BE thật (Cloudflare production)
VITE_ENABLE_MOCKING=true

# Analytics — để trống = tắt (no-op).
# Chỉ fire khi hostname === 'cms.nedu.vn' (prod). Dev / Vercel preview / cms-dev = OFF.
# Set giá trị thực qua Cloudflare Workers dashboard (nedu-cms-prod) + Vercel env vars,
# không commit vào repo.
VITE_GA4_ID=                 # GA4 Measurement ID, format: G-XXXXXXXXXX
VITE_CLARITY_ID=             # MS Clarity Project ID, 10 ký tự alphanumeric
